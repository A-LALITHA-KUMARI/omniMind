# GROQ_API_KEY: Required for Groq AI API calls.
# Configure this via Settings -> Secrets in AI Studio or in your local .env file.
GROQ_API_KEY="your_groq_api_key_here"

# GROQ_MODEL: Configurable Groq model ID (default: llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL="llama-3.3-70b-versatile"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
